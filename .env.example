# Local-only Compose credentials. Replace every secret outside development.
POSTGRES_DB=sewa_motor
POSTGRES_USER=sewa_motor
POSTGRES_PASSWORD=sewa_motor_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080

# Backend runtime.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://sewa_motor:sewa_motor_dev_only@localhost:5432/sewa_motor?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Cold-start resilience for serverless databases (e.g. Railway): retry the
# initial Postgres connection and migrations with exponential backoff + jitter.
DB_CONNECT_MAX_ATTEMPTS=10
DB_CONNECT_MAX_BACKOFF=60s
TZ=Asia/Jakarta
LOG_LEVEL=debug
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=sewa-motor-backend
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_LOG_FORWARDING_ENABLED=true
AUTO_MIGRATE=false
# Enable only after the tenant migration and compatible mobile release.
TENANT_PROVISIONING_ENABLED=false
# Default for businesses without an explicit Superadmin Sandbox setting.
# A saved per-business setting takes precedence.
SANDBOX_ENABLED=false
SANDBOX_RETENTION_DAYS=30
# Fixed safety invariant; any other value is rejected at startup.
SANDBOX_QRIS_AMOUNT=1000
SANDBOX_CLEANUP_INTERVAL=24h
SHUTDOWN_TIMEOUT=10s
SESSION_CACHE_TTL=15m
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=1m
TRUSTED_PROXIES=
SESSION_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
TERMINAL_ENROLLMENT_SECRET=replace-with-at-least-32-random-bytes

# Mobile values are embedded at build time and must never contain secrets.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1
EXPO_EAS_PROJECT_ID=
EXPO_APP_VERSION=1.0.0
EXPO_APP_VERSION_CODE=1

{
  "name": "telomoyo-pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "generate": "turbo run generate",
    "generate:check": "turbo run generate:check",
    "openapi:lint": "redocly lint api/openapi.yaml",
    "compose:config": "docker compose config --quiet",
    "validate:foundation": "pnpm openapi:lint && pnpm --filter @sewa-motor/api-client generate:check && pnpm compose:config",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,md,yaml,yml}\"",
    "infra:up": "docker compose up -d --wait postgres redis",
    "infra:down": "docker compose down",
    "infra:app": "docker compose --profile app up --build",
    "seed:superadmin": "pnpm --filter @sewa-motor/backend run seed:superadmin",
    "clean": "rm -rf node_modules .turbo apps/**/node_modules apps/**/.turbo apps/**/.expo apps/**/dist packages/**/node_modules packages/**/dist dist",
    "reset": "pnpm run clean && pnpm install --frozen-lockfile",
    "refresh-lockfile": "rm -f pnpm-lock.yaml && pnpm install",
    "release:mobile": "scripts/tag-release.sh"
  },
  "devDependencies": {
    "@redocly/cli": "^2.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22 <=24"
  }
}
